cabal-version: 3.12
name:          shibuya-message-db-adapter-jitsurei
version:       0.1.0.0
synopsis:      Runnable examples for shibuya-message-db-adapter
description:
  Stand-alone example executables demonstrating the shibuya-message-db-adapter
  against a real Postgres instance seeded with message-db: basic consumption,
  retry-then-ack, dead-letter-to-stream, checkpoint restart across phases, and
  consumer-group partitioning.

author:        Nadeem Bitar
copyright:     2026 Nadeem Bitar
maintainer:    nadeem@gmail.com
homepage:      https://github.com/shinzui/shibuya-message-db-adapter
bug-reports:
  https://github.com/shinzui/shibuya-message-db-adapter/issues

license:       MIT
license-file:  LICENSE
build-type:    Simple
tested-with:   GHC ==9.12.2
category:      Concurrency, Streaming, EventSourcing

source-repository head
  type:     git
  location: https://github.com/shinzui/shibuya-message-db-adapter.git

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-uni-patterns
    -Wincomplete-record-updates -Wredundant-constraints
    -fhide-source-paths -Wmissing-export-lists -Wpartial-fields
    -Wmissing-deriving-strategies

common common-deps
  build-depends:
    , aeson                        ^>=2.2
    , async                        ^>=2.2
    , base                         ^>=4.21.0.0
    , bytestring                   ^>=0.12
    , containers                   ^>=0.7
    , effectful                    ^>=2.6.1.0
    , effectful-core               ^>=2.6.1.0
    , hasql                        ^>=1.10
    , hasql-effectful              ^>=0.1
    , hasql-pool                   ^>=1.4
    , hs-opentelemetry-api         ^>=0.3
    , message-db-checkpoint-store  ^>=0.1
    , message-db-effectful         ^>=0.1
    , message-db-hs                ^>=0.1
    , shibuya-core                 ^>=0.5.0.0
    , shibuya-message-db-adapter   ^>=0.1.0.0
    , stm                          ^>=2.5
    , streamly                     ^>=0.11
    , streamly-core                ^>=0.3
    , text                         ^>=2.1
    , time                         ^>=1.14
    , uuid                         ^>=1.3
    , uuid-types                   ^>=1.0

  default-extensions:
    DeriveAnyClass
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    QuasiQuotes

  default-language:   GHC2024

executable basic-consumer
  import:         warnings, common-deps
  hs-source-dirs: app
  main-is:        BasicConsumer.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N

executable retry-demo
  import:         warnings, common-deps
  hs-source-dirs: app
  main-is:        RetryDemo.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N

executable dead-letter-demo
  import:         warnings, common-deps
  hs-source-dirs: app
  main-is:        DeadLetterDemo.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N

executable checkpoint-restart
  import:         warnings, common-deps
  hs-source-dirs: app
  main-is:        CheckpointRestart.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N

executable multi-partition
  import:         warnings, common-deps
  hs-source-dirs: app
  main-is:        MultiPartition.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
