-- Allow newer base/ghc-prim/deepseq for packages not yet updated to GHC 9.12.
-- Also relax the containers upper bound for message-db-effectful and
-- message-db-hs so they can build against containers 0.7 (shipped with GHC 9.12.2).
allow-newer:
  proto-lens:base,
  proto-lens:ghc-prim,
  proto-lens:deepseq,
  proto-lens-runtime:base,
  proto-lens-protobuf-types:base,
  proto-lens-protobuf-types:ghc-prim,
  message-db-effectful:containers,
  message-db-hs:containers,
  message-db-checkpoint-store:containers,
  message-db-checkpoint-store:text,
  tan-event-source:containers,
  tan-event-source:generic-lens,
  tan-commons-config:containers,
  tan-commons-time:containers,
  tan-commons-migration:containers,
  tan-hasql:containers,
  tan-hasql:base,
  tan-hasql:hasql,
  tan-hasql:relude,
  hasql-effectful:containers,
  hasql-effectful:hasql,
  message-db-effectful:hasql,
  message-db-hs:hasql

-- shibuya-core pins text ^>=2.1.3 but nix ships text 2.1.2 with GHC 9.12.2
-- through the boot libraries. Allow the older version (the code does not
-- use any 2.1.3-only APIs).
allow-older:
  shibuya-core:text

-- crypton < 1.1.1 depends on `memory`, but hasql-migration depends on `ram`
-- (the renamed successor). The two define distinct ByteArrayAccess classes,
-- so Digest from crypton<1.1.1 has no ram-compatible instance.
constraints:
  crypton >= 1.1.1

test-show-details: direct

-- Disable tests globally (we only want our own test suite; transitive deps
-- should not build their test suites). Re-enable tests for just our package.
tests: False

package shibuya-message-db-adapter
  tests: True
